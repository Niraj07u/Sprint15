# A MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster.example.mongodb.net/prodesk?retryWrites=true&w=majority
# Use a long, random, private signing secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:3000
PORT=4000
NODE_ENV=production

# Server-side Gemini API credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_MS=8000

# Production Logging Configuration
LOG_LEVEL=info

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
